# Copy to .env.local and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe → Developers → API keys (use test keys while developing)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the site (used for Stripe redirects and auth emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
